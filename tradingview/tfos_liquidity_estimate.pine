//@version=6
indicator("TFOS SET Avg Turnover 20D Estimate", shorttitle="TFOS Turnover 20D", overlay=false, precision=2)

isWeekly = timeframe.isweekly and timeframe.multiplier == 1
weeklyTurnover = close * volume
completedWeeklyTurnover = time_close > timenow ? weeklyTurnover[1] : weeklyTurnover
avgTurnover20D = isWeekly ? ta.sma(completedWeeklyTurnover, 4) / 5 : na

plot(avgTurnover20D, title="TV Avg Turnover 20D THB", color=color.teal, linewidth=2)

var table note = table.new(position.top_right, 1, 1)
if barstate.islast
    table.cell(
         note,
         0,
         0,
         isWeekly
             ? "Estimate: 4 completed weekly close x volume bars / 20 trading days"
             : "Select the 1W chart to calculate the estimate",
         text_color=color.white,
         bgcolor=isWeekly ? color.new(color.teal, 35) : color.new(color.orange, 20)
     )
